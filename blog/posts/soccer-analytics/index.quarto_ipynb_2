        "### Loading into Duckdb"
      ],
      "id": "b711ad63"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| label: load-to-duckdb\n",
        "#| warning: false\n",
        "\n",
        "# Helper functions\n",
        "def safe_select(df, columns):\n",
        "    return df[[col for col in columns if col in df.columns]]\n",
        "\n",
        "def clean_names(df):\n",
        "    for col in [\"player_name\", \"pass_recipient_name\"]:\n",
        "        if col in df.columns:\n",
        "            df[col] = df[col].replace(name_map)\n",
        "    return df\n",
        "\n",
        "def process_shots(df):\n",
        "    shots = df[df[\"type_name\"] == \"Shot\"].copy()\n",
        "    shots[\"goal\"] = (shots[\"outcome_name\"] == \"Goal\").astype(int)\n",
        "    return safe_select(shots, [\n",
        "        \"match_id\", \"player_name\", \"team_name\",\n",
        "        \"minute\", \"second\", \"period\",\n",
        "        \"x\", \"y\", \"end_x\", \"end_y\", \"end_z\",\n",
        "        \"shot_statsbomb_xg\", \"outcome_name\",\n",
        "        \"technique_name\", \"body_part_name\",\n",
        "        \"shot_first_time\", \"shot_one_on_one\",\n",
        "        \"shot_open_goal\", \"under_pressure\", \"goal\"\n",
        "    ])\n",
        "\n",
        "def process_passes(df):\n",
        "    passes = df[df[\"type_name\"] == \"Pass\"].copy()\n",
        "    passes[\"incomplete\"] = passes[\"outcome_name\"].isin(\n",
        "        [\"Incomplete\", \"Pass Offside\", \"Out\"]\n",
        "    ).astype(int)\n",
        "    return safe_select(passes, [\n",
        "        \"match_id\", \"player_name\", \"pass_recipient_name\",\n",
        "        \"team_name\", \"possession_team_name\",\n",
        "        \"minute\", \"second\", \"period\",\n",
        "        \"x\", \"y\", \"end_x\", \"end_y\",\n",
        "        \"pass_length\", \"pass_angle\",\n",
        "        \"pass_height_name\", \"pass_cross\",\n",
        "        \"pass_switch\", \"pass_goal_assist\",\n",
        "        \"pass_shot_assist\", \"outcome_name\",\n",
        "        \"under_pressure\", \"incomplete\"\n",
        "    ])\n",
        "\n",
        "# Load all matches\n",
        "all_shots  = []\n",
        "all_passes = []\n",
        "\n",
        "for _, row in matches.iterrows():\n",
        "    df_event, _, _, _ = parser.event(row[\"match_id\"])\n",
        "    df_event = clean_names(df_event)\n",
        "    all_shots.append(process_shots(df_event))\n",
        "    all_passes.append(process_passes(df_event))\n",
        "    print(f\"✅ {row['home_team_name']} vs {row['away_team_name']}\")\n",
        "\n",
        "shots_df  = pd.concat(all_shots,  ignore_index=True)\n",
        "passes_df = pd.concat(all_passes, ignore_index=True)\n",
        "\n",
        "# Save to DuckDB \n",
        "con = duckdb.connect(\"wc2022.duckdb\")\n",
        "con.execute(\"DROP TABLE IF EXISTS matches\")\n",
        "con.execute(\"DROP TABLE IF EXISTS shots\")\n",
        "con.execute(\"DROP TABLE IF EXISTS passes\")\n",
        "con.execute(\"CREATE TABLE matches AS SELECT * FROM matches\")\n",
        "con.execute(\"CREATE TABLE shots  AS SELECT * FROM shots_df\")\n",
        "con.execute(\"CREATE TABLE passes AS SELECT * FROM passes_df\")\n",
        "con.close()\n",
        "\n",
        "print(f\"\\n🦆 DuckDB saved: wc2022.duckdb\")\n",
        "print(f\"   matches : {len(matches):,} rows\")\n",
        "print(f\"   shots   : {len(shots_df):,} rows\")\n",
        "print(f\"   passes  : {len(passes_df):,} rows\")"
      ],
      "id": "load-to-duckdb",
      "execution_count": null,
      "outputs": []
    },
