        "        names = names[names.str.split().str.len() > 3].unique()\n",
        "        long_names.update(names)\n",
        "\n",
        "print(f\"Total long names found: {len(long_names)}\")\n",
        "print(\"\\nFull list:\")\n",
        "for name in sorted(long_names):\n",
